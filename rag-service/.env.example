# Gabay LMS RAG Service Environment Configuration

# LLM Providers
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Upstash Vector Database (768 dimensions, Cosine)
UPSTASH_VECTOR_REST_URL=https://your-upstash-vector-url.upstash.io
UPSTASH_VECTOR_REST_TOKEN=your_upstash_vector_token_here

# Likha ERP (Directus) Ingestion Token
LIKHA_URL=https://gabay.zyberlab.com
LIKHA_TOKEN=your_directus_static_token_here

# Server Configuration
PORT=8000

# Automated Email Dispatch (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_char_app_password
SMTP_FROM=GABAY LMS <your_email@gmail.com>
