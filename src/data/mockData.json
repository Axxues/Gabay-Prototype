      "courseId": "crs-cmsc131",
      "title": "Self-Check Diagnostic Quiz: React Context & Hooks Architecture",
      "instructions": "Answer the following multiple-choice questions. Time limit is 15 minutes. Passing score is 80%.",
      "timeLimitMinutes": 15,
      "published": true,
      "questions": [
        {
          "id": "q1",
          "text": "Which React hook is recommended for synchronizing non-React external storage such as localStorage with component state?",
          "type": "multiple_choice",
          "options": ["useEffect / useSyncExternalStore", "useMemo", "useCallback", "useImperativeHandle"],
          "correctAnswer": "useEffect / useSyncExternalStore",
          "points": 10
        },
        {
          "id": "q2",
          "text": "According to the GABAY Visual Design System guidelines, neon violet radial blur background glows are strictly discouraged.",
          "type": "true_false",
          "options": ["True", "False"],
          "correctAnswer": "True",
          "points": 10
        },
        {
          "id": "q3",
          "text": "What is the primary role restriction for Non-Teaching Staff (Registrar Aide) in GABAY LMS?",
          "type": "multiple_choice",
          "options": [
            "Strictly blocked from viewing individual student assignment grades and quiz submissions",
            "Can alter instructor gradebooks directly",
            "Cannot view course rosters",
            "Full access to student SpeedGrader evaluations"
          ],
          "correctAnswer": "Strictly blocked from viewing individual student assignment grades and quiz submissions",
          "points": 10
        }
      ]
    },
