generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model User {
  id                     String            @id @db.NVarChar(64)
  name                   String            @db.NVarChar(128)
  email                  String            @unique @db.NVarChar(256)
  passwordHash           String            @db.NVarChar(256)
  role                   String            @db.NVarChar(32) // UserRole: admin | faculty | staff | student (enforced at API layer)
  avatar                 String            @db.NVarChar(Max)
  banner                 String?           @db.NVarChar(Max)
  department             String            @db.NVarChar(128)
  title                  String            @db.NVarChar(128)
  lastVisitedAt          String?           @db.NVarChar(Max)
  coursesTaught          Course[]          @relation("InstructorCourses")
  syllabusFacultyMembers SyllabusFaculty[] @relation("SyllabusFacultyUser")
}

model Course {
  id                                String                             @id @db.NVarChar(64)
  code                              String                             @db.NVarChar(32)
  title                             String                             @db.NVarChar(256)
  section                           String                             @db.NVarChar(64)
  term                              String                             @db.NVarChar(64)
  instructorId                      String                             @db.NVarChar(64)
  instructor                        User                               @relation("InstructorCourses", fields: [instructorId], references: [id])
  instructorName                    String                             @db.NVarChar(128)
  published                         Boolean                            @default(false)
  color                             String?                            @db.NVarChar(32)
  image                             String?                            @db.NVarChar(Max)
  enrolledCount                     Int                                @default(0)
  credits                           Int?
  chedComplianceCode                String?                            @db.NVarChar(64)
  joinCode                          String?                            @unique @db.NVarChar(32)
  syllabus                          String?                            @db.NVarChar(Max)
  sprConfig                         String?                            @db.NVarChar(Max)
  gradingTerms                      String?                            @db.NVarChar(Max) // JSON array of TermIds, null = auto-detect
  gradesReleased                    String?                            @db.NVarChar(Max) // JSON map TermId -> boolean, absent = not released
  currentSyllabusId                 String?                            @unique @db.NVarChar(64)
  currentSyllabus                   Syllabus?                          @relation("CurrentCourseSyllabus", fields: [currentSyllabusId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sections                          CourseSection[]
  requests                          EnrollmentRequest[]
  syllabusRevisions                 Syllabus[]                         @relation("CourseSyllabusRevisions")
  syllabusMigrationAuditCourseLinks SyllabusMigrationAuditCourseLink[]
}

model CourseSection {
  id                      String                   @id @db.NVarChar(64)
  courseId                String                   @db.NVarChar(64)
  course                  Course                   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  name                    String                   @db.NVarChar(128)
  capacity                Int?
  enrolledCount           Int                      @default(0)
  schedule                String?                  @db.NVarChar(256)
  location                String?                  @db.NVarChar(256)
  syllabusFacultySections SyllabusFacultySection[] @relation("SyllabusFacultyCourseSection")
}

model EnrollmentRequest {
  id              String    @id @db.NVarChar(64)
  courseId        String    @db.NVarChar(64)
  course          Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  studentId       String    @db.NVarChar(64)
  studentName     String    @db.NVarChar(128)
  type            String    @db.NVarChar(32) // self_join | faculty_enroll | section_switch (enforced at API layer)
  status          String    @default("pending") @db.NVarChar(32) // pending | approved | rejected (enforced at API layer)
  requestedAt     DateTime  @default(now())
  resolvedAt      DateTime?
  resolvedBy      String?   @db.NVarChar(64)
  sectionId       String?   @db.NVarChar(64)
  targetSectionId String?   @db.NVarChar(64)
}

model Module {
  id                   String          @id @db.NVarChar(64)
  courseId             String          @db.NVarChar(64)
  title                String          @db.NVarChar(256)
  order                Int             @default(0)
  published            Boolean         @default(false)
  prerequisiteModuleId String?         @db.NVarChar(64)
  authorId             String?         @db.NVarChar(64)
  authorName           String?         @db.NVarChar(128)
  items                ModuleItem[]
  comments             ModuleComment[]
}

model ModuleItem {
  id                  String  @id @db.NVarChar(64)
  moduleId            String  @db.NVarChar(64)
  module              Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title               String  @db.NVarChar(256)
  type                String  @db.NVarChar(32)
  published           Boolean @default(true)
  required            Boolean @default(false)
  completionCondition String? @db.NVarChar(32)
  minScore            Float?
  content             String? @db.NVarChar(Max)
  activityId          String? @db.NVarChar(64)
  quizId              String? @db.NVarChar(64)
  fileUrl             String? @db.NVarChar(1024)
  fileName            String? @db.NVarChar(256)
  fileSize            String? @db.NVarChar(32)
  fileType            String? @db.NVarChar(64)
  completed           Boolean @default(false)
  authorId            String? @db.NVarChar(64)
  authorName          String? @db.NVarChar(128)
}

model ModuleComment {
  id           String              @id @db.NVarChar(64)
  moduleId     String              @db.NVarChar(64)
  parentId     String?             @db.NVarChar(64)
  module       Module              @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  authorId     String              @db.NVarChar(64)
  authorName   String              @db.NVarChar(128)
  authorAvatar String              @db.NVarChar(Max)
  authorRole   String              @db.NVarChar(32)
  content      String              @db.NVarChar(Max)
  createdAt    DateTime            @default(now())
  likes        Int                 @default(0)
  likedBy      ModuleCommentLike[]
  isEdited     Boolean             @default(false)
  editedAt     DateTime?
}

model ModuleCommentLike {
  commentId String        @db.NVarChar(64)
  comment   ModuleComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String        @db.NVarChar(64)

  @@id([commentId, userId])
}

model Submission {
  id             String              @id @db.NVarChar(64)
  activityKey    String?             @db.NVarChar(64)
  quizId         String?             @db.NVarChar(64)
  quiz           Quiz?               @relation(fields: [quizId], references: [id], onDelete: Cascade)
  activityId     String?             @db.NVarChar(64)
  activity       Activity?           @relation(fields: [activityId], references: [id], onDelete: Cascade)
  examId         String?             @db.NVarChar(64)
  exam           Exam?               @relation(fields: [examId], references: [id], onDelete: Cascade)
  courseId       String              @db.NVarChar(64)
  studentId      String              @db.NVarChar(64)
  studentName    String              @db.NVarChar(128)
  studentAvatar  String              @db.NVarChar(Max)
  submittedAt    DateTime            @default(now())
  submissionType String              @db.NVarChar(32)
  content        String?             @db.NVarChar(Max)
  fileUrl        String?             @db.NVarChar(1024)
  fileName       String?             @db.NVarChar(256)
  grade          Float?
  gradedAt       DateTime?
  gradedBy       String?             @db.NVarChar(128)
  status         String              @db.NVarChar(32)
  rubricScores   String              @db.NVarChar(Max)
  comments       SubmissionComment[]
}

model SubmissionComment {
  id           String     @id @db.NVarChar(64)
  submissionId String     @db.NVarChar(64)
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  authorId     String     @db.NVarChar(64)
  authorName   String     @db.NVarChar(128)
  authorRole   String     @db.NVarChar(32)
  createdAt    DateTime   @default(now())
  text         String     @db.NVarChar(Max)
}

model Quiz {
  id               String         @id @db.NVarChar(64)
  courseId         String         @db.NVarChar(64)
  title            String         @db.NVarChar(256)
  instructions     String         @db.NVarChar(Max)
  timeLimitMinutes Int            @default(30)
  published        Boolean        @default(false)
  delayedUntil     DateTime?
  dueDate          DateTime?
  fileName         String?        @db.NVarChar(256)
  fileUrl          String?        @db.NVarChar(1024)
  fileSize         String?        @db.NVarChar(32)
  term             String?        @db.NVarChar(16) // grading term (prelim|midterm|finals), nullable = legacy rows
  questions        QuizQuestion[]
  submissions      Submission[]
}

model QuizQuestion {
  id            String    @id @db.NVarChar(64)
  quizId        String?   @db.NVarChar(64)
  quiz          Quiz?     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  activityId    String?   @db.NVarChar(64)
  activity      Activity? @relation(fields: [activityId], references: [id], onDelete: Cascade)
  examId        String?   @db.NVarChar(64)
  exam          Exam?     @relation(fields: [examId], references: [id], onDelete: Cascade)
  text          String    @db.NVarChar(Max)
  type          String    @db.NVarChar(32)
  options       String    @db.NVarChar(Max)
  correctAnswer String?   @db.NVarChar(1024)
  points        Float     @default(5)
  description   String?   @db.NVarChar(Max)
  rubricNotes   String?   @db.NVarChar(Max)
  imageUrl      String?   @db.NVarChar(1024)
  imageName     String?   @db.NVarChar(256)
  fileUrl       String?   @db.NVarChar(1024)
  fileName      String?   @db.NVarChar(256)
}

model Activity {
  id                 String         @id @db.NVarChar(64)
  courseId           String         @db.NVarChar(64)
  title              String         @db.NVarChar(256)
  instructions       String         @db.NVarChar(Max)
  pointsPossible     Float
  dueDate            DateTime?
  published          Boolean        @default(false)
  term               String?        @db.NVarChar(16) // grading term (prelim|midterm|finals), nullable = legacy rows
  format             String         @db.NVarChar(16) // 'classic' | 'questionset'
  submissionTypes    String?        @db.NVarChar(64) // classic only, JSON array string
  category           String?        @db.NVarChar(64) // classic only
  weight             Float? // classic only
  rubric             String?        @db.NVarChar(Max) // classic only, JSON array string
  fileName           String?        @db.NVarChar(256) // classic only
  fileUrl            String?        @db.NVarChar(1024) // classic only
  fileSize           String?        @db.NVarChar(32) // classic only
  availableFrom      DateTime? // classic only
  availableUntil     DateTime? // classic only
  sectionRestriction String?        @db.NVarChar(128) // classic only
  assessmentType     String?        @default("activity") @db.NVarChar(32)
  metadata           String?        @db.NVarChar(Max)
  questions          QuizQuestion[]
  submissions        Submission[]
}

model Exam {
  id               String         @id @db.NVarChar(64)
  courseId         String         @db.NVarChar(64)
  title            String         @db.NVarChar(256)
  instructions     String         @db.NVarChar(Max)
  timeLimitMinutes Int            @default(30)
  published        Boolean        @default(false)
  dueDate          DateTime?
  term             String         @db.NVarChar(16)
  questions        QuizQuestion[]
  submissions      Submission[]
}

model Announcement {
  id                         String                   @id @db.NVarChar(64)
  courseId                   String                   @db.NVarChar(64)
  title                      String                   @db.NVarChar(256)
  content                    String                   @db.NVarChar(Max)
  authorId                   String                   @db.NVarChar(64)
  authorName                 String                   @db.NVarChar(128)
  authorAvatar               String                   @db.NVarChar(Max)
  authorRole                 String                   @db.NVarChar(32)
  createdAt                  DateTime                 @default(now())
  delayedUntil               DateTime?
  sectionId                  String                   @default("all") @db.NVarChar(64)
  sectionRestriction         String                   @default("All Sections") @db.NVarChar(128)
  allowComments              Boolean                  @default(true)
  usersMustPostBeforeReplies Boolean                  @default(false)
  allowLiking                Boolean                  @default(true)
  likes                      Int                      @default(0)
  pinned                     Boolean                  @default(false)
  attachments                AnnouncementAttachment[]
  replies                    AnnouncementReply[]
  likedBy                    AnnouncementLike[]
  readBy                     AnnouncementRead[]
}

model AnnouncementAttachment {
  id             String       @id @default(cuid()) @db.NVarChar(64)
  announcementId String       @db.NVarChar(64)
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  name           String       @db.NVarChar(256)
  size           String       @db.NVarChar(32)
  url            String?      @db.NVarChar(1024)
}

model AnnouncementReply {
  id             String                  @id @db.NVarChar(64)
  announcementId String                  @db.NVarChar(64)
  parentId       String?                 @db.NVarChar(64)
  announcement   Announcement            @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  authorId       String                  @db.NVarChar(64)
  authorName     String                  @db.NVarChar(128)
  authorAvatar   String                  @db.NVarChar(Max)
  authorRole     String                  @db.NVarChar(32)
  content        String                  @db.NVarChar(Max)
  createdAt      DateTime                @default(now())
  likes          Int                     @default(0)
  likedBy        AnnouncementReplyLike[]
}

model AnnouncementReplyLike {
  replyId String            @db.NVarChar(64)
  reply   AnnouncementReply @relation(fields: [replyId], references: [id], onDelete: Cascade)
  userId  String            @db.NVarChar(64)

  @@id([replyId, userId])
}

model AnnouncementLike {
  announcementId String       @db.NVarChar(64)
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String       @db.NVarChar(64)

  @@id([announcementId, userId])
}

model AnnouncementRead {
  announcementId String       @db.NVarChar(64)
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String       @db.NVarChar(64)

  @@id([announcementId, userId])
}

model Discussion {
  id                         String            @id @db.NVarChar(64)
  courseId                   String            @db.NVarChar(64)
  title                      String            @db.NVarChar(256)
  prompt                     String            @db.NVarChar(Max)
  authorId                   String            @db.NVarChar(64)
  authorName                 String            @db.NVarChar(128)
  authorAvatar               String            @db.NVarChar(Max)
  authorRole                 String            @db.NVarChar(32)
  createdAt                  DateTime          @default(now())
  isGraded                   Boolean           @default(false)
  pointsPossible             Float?
  dueDate                    DateTime?
  pinned                     Boolean           @default(false)
  locked                     Boolean           @default(false)
  usersMustPostBeforeReplies Boolean           @default(false)
  groupActivity              String?           @db.NVarChar(128)
  replies                    DiscussionReply[]
}

model DiscussionReply {
  id           String                @id @db.NVarChar(64)
  discussionId String                @db.NVarChar(64)
  discussion   Discussion            @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  parentId     String?               @db.NVarChar(64)
  authorId     String                @db.NVarChar(64)
  authorName   String                @db.NVarChar(128)
  authorAvatar String                @db.NVarChar(Max)
  authorRole   String                @db.NVarChar(32)
  content      String                @db.NVarChar(Max)
  createdAt    DateTime              @default(now())
  likes        Int                   @default(0)
  likedBy      DiscussionReplyLike[]
}

model DiscussionReplyLike {
  replyId String          @db.NVarChar(64)
  reply   DiscussionReply @relation(fields: [replyId], references: [id], onDelete: Cascade)
  userId  String          @db.NVarChar(64)

  @@id([replyId, userId])
}

model Message {
  id             String   @id @db.NVarChar(64)
  senderId       String   @db.NVarChar(64)
  senderName     String   @db.NVarChar(128)
  senderRole     String   @db.NVarChar(32)
  recipientId    String   @db.NVarChar(64)
  recipientName  String   @db.NVarChar(128)
  recipientRole  String   @db.NVarChar(32)
  courseId       String?  @db.NVarChar(64)
  courseCode     String?  @db.NVarChar(32)
  subject        String   @db.NVarChar(256)
  body           String   @db.NVarChar(Max)
  timestamp      DateTime @default(now())
  read           Boolean  @default(false)
  reaction       String?  @db.NVarChar(32)
  attachmentName String?  @db.NVarChar(256)
  attachmentSize String?  @db.NVarChar(32)
  groupId        String?  @db.NVarChar(64)
  isGroup        Boolean  @default(false)
}

model ChatGroup {
  id         String            @id @db.NVarChar(64)
  name       String            @db.NVarChar(128)
  avatar     String?           @db.NVarChar(Max)
  courseId   String?           @db.NVarChar(64)
  courseCode String?           @db.NVarChar(32)
  createdAt  DateTime          @default(now())
  createdBy  String            @db.NVarChar(64)
  members    ChatGroupMember[]
}

model ChatGroupMember {
  groupId String    @db.NVarChar(64)
  group   ChatGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId  String    @db.NVarChar(64)

  @@id([groupId, userId])
}

model CalendarEvent {
  id              String    @id @db.NVarChar(64)
  title           String    @db.NVarChar(256)
  date            String    @db.NVarChar(32)
  time            String    @db.NVarChar(32)
  courseId        String?   @db.NVarChar(64)
  courseCode      String?   @db.NVarChar(32)
  type            String    @db.NVarChar(32)
  description     String    @db.NVarChar(Max)
  createdAt       DateTime?
  startAt         DateTime?
  endAt           DateTime?
  isAllDay        Boolean   @default(false)
  colorHex        String?   @db.NVarChar(32)
  location        String?   @db.NVarChar(256)
  meetingPlatform String?   @db.NVarChar(32)
  meetingId       String?   @db.NVarChar(128)
  meetingPasscode String?   @db.NVarChar(128)
  meetingJoinUrl  String?   @db.NVarChar(1024)
}

model AdvisingSlot {
  id                  String  @id @db.NVarChar(64)
  instructorId        String  @db.NVarChar(64)
  instructorName      String  @db.NVarChar(128)
  date                String  @db.NVarChar(32)
  timeSlot            String  @db.NVarChar(64)
  location            String  @db.NVarChar(256)
  status              String  @db.NVarChar(32)
  bookedByStudentId   String? @db.NVarChar(64)
  bookedByStudentName String? @db.NVarChar(128)
  notes               String? @db.NVarChar(Max)
}

model Notification {
  id           String   @id @db.NVarChar(64)
  type         String   @db.NVarChar(64)
  recipientId  String   @db.NVarChar(64)
  actorId      String   @db.NVarChar(64)
  actorName    String   @db.NVarChar(128)
  actorAvatar  String   @db.NVarChar(Max)
  relatedId    String   @db.NVarChar(64)
  relatedTitle String   @db.NVarChar(256)
  content      String   @db.NVarChar(Max)
  read         Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model CourseFolder {
  id        String         @id @db.NVarChar(64)
  courseId  String         @db.NVarChar(64)
  parentId  String?        @db.NVarChar(64)
  parent    CourseFolder?  @relation("FolderChildren", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children  CourseFolder[] @relation("FolderChildren")
  name      String         @db.NVarChar(256)
  updatedAt DateTime       @updatedAt
  autoKey   String?        @db.NVarChar(128)
  files     CourseFile[]
}

model CourseFile {
  id                      String                   @id @db.NVarChar(64)
  courseId                String                   @db.NVarChar(64)
  folderId                String?                  @db.NVarChar(64)
  folder                  CourseFolder?            @relation(fields: [folderId], references: [id], onDelete: SetNull)
  name                    String                   @db.NVarChar(256)
  size                    Int                      @default(0)
  formattedSize           String                   @db.NVarChar(32)
  type                    String                   @db.NVarChar(32)
  visibility              String                   @db.NVarChar(32)
  updatedAt               DateTime                 @updatedAt
  uploadedBy              String                   @db.NVarChar(64)
  uploadedByName          String                   @db.NVarChar(128)
  content                 String?                  @db.NVarChar(Max)
  url                     String?                  @db.NVarChar(1024)
  fileUrl                 String?                  @db.NVarChar(1024)
  sourceArea              String?                  @db.NVarChar(32)
  sourceId                String?                  @db.NVarChar(64)
  syllabusSourceDocuments SyllabusSourceDocument[] @relation("SyllabusSourceFile")
}

model Syllabus {
  id                          String                               @id @db.NVarChar(64)
  courseId                    String                               @db.NVarChar(64)
  course                      Course                               @relation("CourseSyllabusRevisions", fields: [courseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  currentForCourse            Course?                              @relation("CurrentCourseSyllabus")
  parentSyllabusId            String?                              @db.NVarChar(64)
  parent                      Syllabus?                            @relation("SyllabusParent", fields: [parentSyllabusId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children                    Syllabus[]                           @relation("SyllabusParent")
  revisionNo                  Int
  status                      String                               @default("draft") @db.NVarChar(32)
  schemaVersion               String                               @default("1") @db.NVarChar(32)
  rowVersion                  Int                                  @default(1)
  createdById                 String                               @db.NVarChar(64)
  publishedById               String?                              @db.NVarChar(64)
  createdAt                   DateTime                             @default(now())
  updatedAt                   DateTime                             @updatedAt
  publishedAt                 DateTime?
  institution                 SyllabusInstitution?
  courseInfo                  SyllabusCourseInfo?
  institutionalStatement      SyllabusInstitutionalStatement?
  gradingSystem               SyllabusGradingSystem?
  sourceDocument              SyllabusSourceDocument?
  faculty                     SyllabusFaculty[]
  requirements                SyllabusRequirement[]
  policies                    SyllabusPolicy[]
  rubrics                     SyllabusRubric[]
  outlineBlocks               SyllabusOutlineBlock[]
  learningPlans               SyllabusLearningPlan[]
  courseOutcomes              SyllabusCourseOutcome[]
  courseMaps                  SyllabusCourseMap[]
  references                  SyllabusReference[]
  signatories                 SyllabusSignatory[]
  extensionFields             SyllabusExtensionField[]
  programOutcomes             SyllabusProgramOutcome[]
  coreValues                  SyllabusCoreValue[]
  graduateAttributes          SyllabusGraduateAttribute[]
  migrationAuditRevisionLinks SyllabusMigrationAuditRevisionLink[]

  @@unique([courseId, revisionNo])
}

model ProgramOutcome {
  id             String                            @id @db.NVarChar(64)
  number         Int
  description    String                            @db.NVarChar(Max)
  catalogVersion String                            @db.NVarChar(64)
  createdAt      DateTime                          @default(now())
  updatedAt      DateTime                          @updatedAt
  syllabi        SyllabusProgramOutcome[]
  courseMaps     SyllabusCourseMapProgramOutcome[]

  @@unique([catalogVersion, number])
}

model CoreValue {
  id             String              @id @db.NVarChar(64)
  acronym        String              @db.NVarChar(64)
  keyword        String              @db.NVarChar(256)
  description    String              @db.NVarChar(Max)
  catalogVersion String              @db.NVarChar(64)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  syllabi        SyllabusCoreValue[]

  @@unique([catalogVersion, acronym])
}

model GraduateAttribute {
  id             String                      @id @db.NVarChar(64)
  number         Int
  title          String                      @db.NVarChar(256)
  description    String                      @db.NVarChar(Max)
  catalogVersion String                      @db.NVarChar(64)
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt
  syllabi        SyllabusGraduateAttribute[]

  @@unique([catalogVersion, number])
}

model SyllabusProgramOutcome {
  syllabusId       String         @db.NVarChar(64)
  syllabus         Syllabus       @relation(fields: [syllabusId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  programOutcomeId String         @db.NVarChar(64)
  programOutcome   ProgramOutcome @relation(fields: [programOutcomeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  position         Int

  @@id([syllabusId, programOutcomeId, position])
  @@unique([syllabusId, position])
}

model SyllabusCoreValue {
  syllabusId  String    @db.NVarChar(64)
  syllabus    Syllabus  @relation(fields: [syllabusId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  coreValueId String    @db.NVarChar(64)
  coreValue   CoreValue @relation(fields: [coreValueId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  position    Int

  @@id([syllabusId, coreValueId, position])
  @@unique([syllabusId, position])
}

model SyllabusGraduateAttribute {
  syllabusId          String            @db.NVarChar(64)
  syllabus            Syllabus          @relation(fields: [syllabusId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  graduateAttributeId String            @db.NVarChar(64)
  graduateAttribute   GraduateAttribute @relation(fields: [graduateAttributeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  position            Int

  @@id([syllabusId, graduateAttributeId, position])
  @@unique([syllabusId, position])
}

model SyllabusInstitution {
  syllabusId String   @id @db.NVarChar(64)
  syllabus   Syllabus @relation(fields: [syllabusId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  university String   @db.NVarChar(256)
  college    String   @db.NVarChar(256)
  formCode   String   @db.NVarChar(64)
  revision   String   @db.NVarChar(64)
}

model SyllabusCourseInfo {
  syllabusId   String   @id @db.NVarChar(64)
  syllabus     Syllabus @relation(fields: [syllabusId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  code         String   @db.NVarChar(64)
  title        String   @db.NVarChar(256)
  semester     String   @db.NVarChar(128)
  academicYear String   @db.NVarChar(64)
  type         String   @db.NVarChar(128)
  credit       String   @db.NVarChar(32)
  lectureHours Int
  labHours     Int
  prerequisite String   @db.NVarChar(Max)
  description  String   @db.NVarChar(Max)
}

model SyllabusInstitutionalStatement {
  syllabusId String   @id @db.NVarChar(64)
  syllabus   Syllabus @relation(fields: [syllabusId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  philosophy String   @db.NVarChar(Max)
  vision     String   @db.NVarChar(Max)
  mission    String   @db.NVarChar(Max)
  goal       String   @db.NVarChar(Max)
}

model SyllabusGradingSystem {
  syllabusId   String                     @id @db.NVarChar(64)
  syllabus     Syllabus                   @relation(fields: [syllabusId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  termFormula  String                     @db.NVarChar(256)
  finalFormula String                     @db.NVarChar(256)
  passingGrade String                     @db.NVarChar(64)
  components   SyllabusGradingComponent[]
}

model SyllabusSourceDocument {
  syllabusId    String      @id @db.NVarChar(64)
  syllabus      Syllabus    @relation(fields: [syllabusId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  fileName      String      @db.NVarChar(256)
  fileSize      String      @db.NVarChar(32)
  fileType      String      @db.NVarChar(32)
  uploadedAt    DateTime
  fileDataUrl   String?     @db.NVarChar(Max)
  legacyPayload String?     @db.NVarChar(Max)
  courseFileId  String?     @db.NVarChar(64)
  courseFile    CourseFile? @relation("SyllabusSourceFile", fields: [courseFileId], references: [id], onDelete: SetNull, onUpdate: NoAction)
}

model SyllabusFaculty {
  id           String                   @id @db.NVarChar(64)
  syllabusId   String                   @db.NVarChar(64)
  syllabus     Syllabus                 @relation(fields: [syllabusId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  name         String                   @db.NVarChar(256)
  consultation String                   @db.NVarChar(Max)
  position     Int
  userId       String?                  @db.NVarChar(64)
  user         User?                    @relation("SyllabusFacultyUser", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sections     SyllabusFacultySection[]

  @@unique([syllabusId, position])
}

model SyllabusFacultySection {
  id              String          @id @db.NVarChar(64)
  facultyId       String          @db.NVarChar(64)
  faculty         SyllabusFaculty @relation(fields: [facultyId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  section         String          @db.NVarChar(128)
  schedule        String          @db.NVarChar(256)
  room            String          @db.NVarChar(256)
  position        Int
  courseSectionId String?         @db.NVarChar(64)
  courseSection   CourseSection?  @relation("SyllabusFacultyCourseSection", fields: [courseSectionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([facultyId, position])
}

model SyllabusRequirement {
  id         String   @id @db.NVarChar(64)
  syllabusId String   @db.NVarChar(64)
  syllabus   Syllabus @relation(fields: [syllabusId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  category   String   @db.NVarChar(32)
  text       String   @db.NVarChar(Max)
  position   Int

  @@unique([syllabusId, position])
}

model SyllabusPolicy {
  id         String   @id @db.NVarChar(64)
  syllabusId String   @db.NVarChar(64)
  syllabus   Syllabus @relation(fields: [syllabusId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  text       String   @db.NVarChar(Max)
  position   Int

  @@unique([syllabusId, position])
}

model SyllabusGradingComponent {
  id              String                @id @db.NVarChar(64)
  gradingSystemId String                @db.NVarChar(64)
  gradingSystem   SyllabusGradingSystem @relation(fields: [gradingSystemId], references: [syllabusId], onDelete: Cascade, onUpdate: NoAction)
  text            String                @db.NVarChar(Max)
  position        Int

  @@unique([gradingSystemId, position])
}

model SyllabusRubric {
  id         String                @id @db.NVarChar(64)
  syllabusId String                @db.NVarChar(64)
  syllabus   Syllabus              @relation(fields: [syllabusId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  category   String                @db.NVarChar(256)
  position   Int
  levels     SyllabusRubricLevel[]

  @@unique([syllabusId, position])
}

model SyllabusRubricLevel {
  rubricId    String         @db.NVarChar(64)
  rubric      SyllabusRubric @relation(fields: [rubricId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  level       Int
  description String         @db.NVarChar(Max)

  @@id([rubricId, level])
}

model SyllabusOutlineBlock {
  id         String                 @id @db.NVarChar(64)
  syllabusId String                 @db.NVarChar(64)
  syllabus   Syllabus               @relation(fields: [syllabusId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  timeFrame  String                 @db.NVarChar(256)
  title      String                 @db.NVarChar(256)
  position   Int
  topics     SyllabusOutlineTopic[]

  @@unique([syllabusId, position])
}

model SyllabusOutlineTopic {
  id             String               @id @db.NVarChar(64)
  outlineBlockId String               @db.NVarChar(64)
  outlineBlock   SyllabusOutlineBlock @relation(fields: [outlineBlockId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  text           String               @db.NVarChar(Max)
  position       Int

  @@unique([outlineBlockId, position])
}

model SyllabusLearningPlan {
  id          String                           @id @db.NVarChar(64)
  syllabusId  String                           @db.NVarChar(64)
  syllabus    Syllabus                         @relation(fields: [syllabusId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  week        String                           @db.NVarChar(128)
  hoursLab    Int
  hoursLec    Int
  position    Int
  outcomes    SyllabusLearningPlanOutcome[]
  topics      SyllabusLearningPlanTopic[]
  methods     SyllabusLearningPlanMethod[]
  resources   SyllabusLearningPlanResource[]
  assessments SyllabusLearningPlanAssessment[]
  sdg         SyllabusLearningPlanSdg?

  @@unique([syllabusId, position])
}

model SyllabusLearningPlanOutcome {
  id             String               @id @db.NVarChar(64)
  learningPlanId String               @db.NVarChar(64)
  learningPlan   SyllabusLearningPlan @relation(fields: [learningPlanId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  text           String               @db.NVarChar(Max)
  position       Int

  @@unique([learningPlanId, position])
}

model SyllabusLearningPlanTopic {
  id             String               @id @db.NVarChar(64)
  learningPlanId String               @db.NVarChar(64)
  learningPlan   SyllabusLearningPlan @relation(fields: [learningPlanId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  text           String               @db.NVarChar(Max)
  position       Int

  @@unique([learningPlanId, position])
}

model SyllabusLearningPlanMethod {
  id             String               @id @db.NVarChar(64)
  learningPlanId String               @db.NVarChar(64)
  learningPlan   SyllabusLearningPlan @relation(fields: [learningPlanId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  text           String               @db.NVarChar(Max)
  position       Int

  @@unique([learningPlanId, position])
}

model SyllabusLearningPlanResource {
  id             String               @id @db.NVarChar(64)
  learningPlanId String               @db.NVarChar(64)
  learningPlan   SyllabusLearningPlan @relation(fields: [learningPlanId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  text           String               @db.NVarChar(Max)
  position       Int

  @@unique([learningPlanId, position])
}

model SyllabusLearningPlanAssessment {
  id             String               @id @db.NVarChar(64)
  learningPlanId String               @db.NVarChar(64)
  learningPlan   SyllabusLearningPlan @relation(fields: [learningPlanId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  text           String               @db.NVarChar(Max)
  position       Int

  @@unique([learningPlanId, position])
}

model SyllabusLearningPlanSdg {
  learningPlanId String               @id @db.NVarChar(64)
  learningPlan   SyllabusLearningPlan @relation(fields: [learningPlanId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  goal           String               @db.NVarChar(64)
  title          String               @db.NVarChar(256)
  description    String               @db.NVarChar(Max)
  target         String?              @db.NVarChar(Max)
}

model SyllabusCourseOutcome {
  id         String             @id @db.NVarChar(64)
  syllabusId String             @db.NVarChar(64)
  syllabus   Syllabus           @relation(fields: [syllabusId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  number     Int
  statement  String             @db.NVarChar(Max)
  position   Int
  courseMap  SyllabusCourseMap?

  @@unique([syllabusId, number])
  @@unique([syllabusId, position])
}

model SyllabusCourseMap {
  id              String                            @id @db.NVarChar(64)
  syllabusId      String                            @db.NVarChar(64)
  syllabus        Syllabus                          @relation(fields: [syllabusId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  courseOutcomeId String                            @unique @db.NVarChar(64)
  courseOutcome   SyllabusCourseOutcome             @relation(fields: [courseOutcomeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  coNumber        Int
  coStatement     String                            @db.NVarChar(Max)
  position        Int
  programOutcomes SyllabusCourseMapProgramOutcome[]

  @@unique([syllabusId, position])
}

model SyllabusCourseMapProgramOutcome {
  courseMapId      String            @db.NVarChar(64)
  courseMap        SyllabusCourseMap @relation(fields: [courseMapId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  programOutcomeId String            @db.NVarChar(64)
  programOutcome   ProgramOutcome    @relation(fields: [programOutcomeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  level            String            @db.NVarChar(1)
  position         Int

  @@id([courseMapId, programOutcomeId])
  @@unique([courseMapId, position])
}

model SyllabusReference {
  id             String   @id @db.NVarChar(64)
  syllabusId     String   @db.NVarChar(64)
  syllabus       Syllabus @relation(fields: [syllabusId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  citation       String   @db.NVarChar(Max)
  year           String   @db.NVarChar(32)
  doiOrPublisher String?  @db.NVarChar(Max)
  position       Int

  @@unique([syllabusId, position])
}

model SyllabusSignatory {
  id         String   @id @db.NVarChar(64)
  syllabusId String   @db.NVarChar(64)
  syllabus   Syllabus @relation(fields: [syllabusId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  role       String   @db.NVarChar(32)
  name       String   @db.NVarChar(256)
  title      String   @db.NVarChar(256)
  position   Int

  @@unique([syllabusId, position])
}

model SyllabusExtensionField {
  id         String   @id @db.NVarChar(64)
  syllabusId String   @db.NVarChar(64)
  syllabus   Syllabus @relation(fields: [syllabusId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  path       String   @db.NVarChar(512)
  value      String   @db.NVarChar(Max)
  valueType  String   @db.NVarChar(64)

  @@unique([syllabusId, path])
}

model SyllabusMigrationAudit {
  id                 String                              @id @db.NVarChar(64)
  originalCourseId   String                              @db.NVarChar(64)
  originalRevisionId String?                             @db.NVarChar(64)
  sourceChecksum     String                              @db.NVarChar(128)
  status             String                              @db.NVarChar(32)
  scannedCount       Int                                 @default(0)
  createdCount       Int                                 @default(0)
  updatedCount       Int                                 @default(0)
  skippedCount       Int                                 @default(0)
  conflictedCount    Int                                 @default(0)
  errorText          String?                             @db.NVarChar(Max)
  createdAt          DateTime                            @default(now())
  updatedAt          DateTime                            @updatedAt
  completedAt        DateTime?
  courseLink         SyllabusMigrationAuditCourseLink?
  revisionLink       SyllabusMigrationAuditRevisionLink?

  @@unique([originalCourseId, sourceChecksum])
}

model SyllabusMigrationAuditCourseLink {
  auditId  String                 @id @db.NVarChar(64)
  audit    SyllabusMigrationAudit @relation(fields: [auditId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  courseId String?                @db.NVarChar(64)
  course   Course?                @relation(fields: [courseId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([courseId])
}

model SyllabusMigrationAuditRevisionLink {
  auditId    String                 @id @db.NVarChar(64)
  audit      SyllabusMigrationAudit @relation(fields: [auditId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  revisionId String?                @db.NVarChar(64)
  revision   Syllabus?              @relation(fields: [revisionId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([revisionId])
}

model HistoryLog {
  id        String   @id @db.NVarChar(64)
  path      String   @db.NVarChar(512)
  title     String   @db.NVarChar(256)
  timestamp DateTime @default(now())
}

model CourseGrade {
  courseId     String   @db.NVarChar(64)
  studentId    String   @db.NVarChar(64)
  midtermGrade Float?
  finalGrade   Float?
  sprCells     String?  @db.NVarChar(Max)
  updatedAt    DateTime @updatedAt

  @@id([courseId, studentId])
}

model CommonsTemplate {
  id            String @id @db.NVarChar(64)
  title         String @db.NVarChar(256)
  category      String @db.NVarChar(128)
  description   String @db.NVarChar(Max)
  author        String @db.NVarChar(128)
  downloads     Int    @default(0)
  rating        Float  @default(0)
  tags          String @db.NVarChar(Max)
  chedAlignment String @db.NVarChar(512)
}
