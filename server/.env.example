# server/.env.example — copy to .env and fill in the gabay_app password.
# NOTE: use a SINGLE backslash for named instances (dotenv preserves
# backslashes literally; a double backslash fails Prisma parsing with P1013).
# If the engine uses a dynamic TCP port instead of static 1433, put the
# current port here (e.g. DESKTOP-DTAQOP7:63313 with NO instance segment —
# an instance name plus an explicit port makes tedious attempt a SQL Browser
# lookup instead of direct TCP). Static port 1433 is recommended for stability.
DATABASE_URL="sqlserver://DESKTOP-DTAQOP7\SQLEXPRESS:1433;database=GabayPrototype;user=gabay_app;password=CHANGE_ME;encrypt=true;trustServerCertificate=true"
JWT_SECRET="CHANGE_ME_DEV_ONLY"
PORT="4000"
