@startuml
title Gabay LMS - Student Use Case
left to right direction
skinparam usecase {
  BackgroundColor #8AC9F5
  BorderColor black
}
skinparam actor {
  BackgroundColor #8AC9F5
  BorderColor black
}
skinparam rectangle {
  BackgroundColor white
  BorderColor black
}
skinparam arrowColor black
skinparam linetype polyline
skinparam nodesep 6
skinparam ranksep 12

actor "Student" as Student

rectangle "Gabay LMS" {
  together {
    usecase "Join Course via Code" as UC1
    usecase "Wait for Faculty Approval" as UC1w
    usecase "Accept Course Invitation" as UC1b
  }
  together {
    usecase "View Modules" as UC4
    usecase "View Items" as UC4i
    usecase "Add / Reply Comment" as UC4r
    usecase "View Syllabus" as UC4b
    usecase "Download Module Files" as UC4m
    usecase "Download Syllabus Files" as UC4s
  }
  together {
    usecase "Take Activities" as UC5
    usecase "Submit Requirements" as UC5s
    usecase "Take Quizzes" as UC6
    usecase "Take Exams" as UC6b
    usecase "View Grades and SPR" as UC7
  }
  together {
    usecase "View Announcements" as UC8
    usecase "Add / Reply Comment" as UC8b
  }
  together {
    usecase "Access Calendar" as UC9
  }
  together {
    usecase "Access Inbox" as UC10
    usecase "Direct message users" as UC10a
    usecase "Create group" as UC10b
    usecase "Message group" as UC10c
  }
  together {
    usecase "Access Gabay RAG" as UCRAG
    usecase "Generate Graph" as UCRAG_G
    usecase "Generate Tables" as UCRAG_T
    usecase "Generate Report" as UCRAG_R
  }
  together {
    usecase "Access History" as UC11
  }
}

Student --> UC1
Student --> UC1b
Student --> UC4
Student --> UC4b
Student --> UC5
Student --> UC6
Student --> UC6b
Student --> UC7
Student --> UC8
Student --> UC9
Student --> UC10
Student --> UCRAG
Student --> UC11

UC1 ..> UC1w : <<include>>
UC4 ..> UC4i : <<include>>
UC4 ..> UC4r : <<extend>>
UC4i ..> UC4m : <<extend>>
UC4b ..> UC4s : <<extend>>
UC5 ..> UC5s : <<include>>
UC8 ..> UC8b : <<extend>>
UC10 ..> UC10a : <<extend>>
UC10 ..> UC10b : <<extend>>
UC10b ..> UC10c : <<extend>>
UCRAG ..> UCRAG_G : <<extend>>
UCRAG ..> UCRAG_T : <<extend>>
UCRAG ..> UCRAG_R : <<extend>>
@enduml
