// Gabay LMS - DFD Level 1 (Part A: Accounts, Enrollment, Content).
// Gane-Sarson notation: external entity = yellow rectangle, process = rounded
// box (number top-left, name middle, yellow bands), data store = rectangle
// (grey D-id + yellow name). See dfd-level1b.dot for processes 4-6.
// NOTE: exports/dfd-level1a.svg is the master artwork (hand-aligned exact
// lanes/labels, same technique as dfd-context.svg); this .dot documents the
// same flows/symbols and is not re-rendered.
// Stores map to docs/diagrams/erd.puml: D1 User; D2 Course(+Section,
// EnrollmentRequest); D3 Module(+ModuleItem), CourseFile, Syllabus.
digraph dfd_level1a {
  rankdir=LR;
  label="Gabay LMS - DFD Level 1 (A: Accounts, Enrollment, Content)";
  labelloc="t";
  fontsize="16";
  fontname="Arial";
  node [fontsize="11", fontname="Arial"];
  edge [fontsize="10", fontname="Arial", arrowhead=vee];
  splines=ortho; ranksep=2.0; nodesep=1.8; overlap=false;
  pad=0.5;

  { rank=source; Admin; Student; Faculty; }
  { rank=same; P1; P2; P3; }
  { rank=sink; D1; D2; D3; }
  // ponytail: invisible chains pin top-to-bottom order inside each column
  Admin -> Student -> Faculty [style=invis];
  P1 -> P2 -> P3 [style=invis];
  D1 -> D2 -> D3 [style=invis];

  Admin [shape=box, style=filled, fillcolor="#FFF59D", group=g1];
  Student [shape=box, style=filled, fillcolor="#FFF59D", group=g2];
  Faculty [shape=box, style=filled, fillcolor="#FFF59D", group=g3];

  // ponytail: HTML-table processes mimic Gane-Sarson rounded boxes
  P1 [shape=plaintext, group=g1, label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" STYLE="ROUNDED" BGCOLOR="#FFF59D">
      <TR><TD ALIGN="LEFT">1</TD></TR><HR/>
      <TR><TD BGCOLOR="WHITE">Manage Accounts</TD></TR><HR/>
      <TR><TD> </TD></TR>
    </TABLE>
  >];
  P2 [shape=plaintext, group=g2, label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" STYLE="ROUNDED" BGCOLOR="#FFF59D">
      <TR><TD ALIGN="LEFT">2</TD></TR><HR/>
      <TR><TD BGCOLOR="WHITE">Manage Enrollment</TD></TR><HR/>
      <TR><TD> </TD></TR>
    </TABLE>
  >];
  P3 [shape=plaintext, group=g3, label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" STYLE="ROUNDED" BGCOLOR="#FFF59D">
      <TR><TD ALIGN="LEFT">3</TD></TR><HR/>
      <TR><TD BGCOLOR="WHITE">Manage Content<BR/>and Syllabus</TD></TR><HR/>
      <TR><TD> </TD></TR>
    </TABLE>
  >];

  D1 [shape=plaintext, group=g1, label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6">
      <TR><TD BGCOLOR="#D3D3D3">D1</TD><TD BGCOLOR="#FFF59D">Users</TD></TR>
    </TABLE>
  >];
  D2 [shape=plaintext, group=g2, label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6">
      <TR><TD BGCOLOR="#D3D3D3">D2</TD><TD BGCOLOR="#FFF59D">Courses and<BR/>Enrollments</TD></TR>
    </TABLE>
  >];
  D3 [shape=plaintext, group=g3, label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6">
      <TR><TD BGCOLOR="#D3D3D3">D3</TD><TD BGCOLOR="#FFF59D">Content and<BR/>Syllabus</TD></TR>
    </TABLE>
  >];

  // ponytail: compass ports keep each direction in its own ortho lane
  Admin:ne -> P1:nw [xlabel="account data"];
  P1:sw -> Admin:se [xlabel="confirmation"];
  P1:e -> D1:w [xlabel="store accounts"];
  D1:sw -> P2:ne [xlabel="account records"];

  Student:ne -> P2:nw [xlabel="join code"];
  P2:w -> Student:e [xlabel="decision notice"];
  Faculty:n -> P2:se [xlabel="enrollment request"];
  P2:sw -> Faculty:e [xlabel="approval decision"];
  P2:e -> D2:w [xlabel="enrollment records"];

  Faculty:ne -> P3:nw [xlabel="modules, items,\nsyllabus files"];
  P3:e -> D3:w [xlabel="store content"];
  Student:s -> P3:n [xlabel="view / download request"];
  P3:w -> Student:se [xlabel="content files"];
}
