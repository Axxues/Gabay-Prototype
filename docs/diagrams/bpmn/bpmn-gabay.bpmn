      <bpmndi:BPMNShape id="Sh_S_Join" bpmnElement="S_Join"><dc:Bounds x="350" y="65" width="110" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_S_SendReq" bpmnElement="S_SendReq"><dc:Bounds x="490" y="65" width="110" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_S_RecvDec" bpmnElement="S_RecvDec"><dc:Bounds x="880" y="65" width="110" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_S_Appr" bpmnElement="S_Appr" isMarkerVisible="true"><dc:Bounds x="1020" y="75" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_S_EndRej" bpmnElement="S_EndRej"><dc:Bounds x="1027" y="150" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_S_View" bpmnElement="S_View"><dc:Bounds x="1100" y="65" width="110" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_S_Take" bpmnElement="S_Take"><dc:Bounds x="1240" y="65" width="110" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_S_Submit" bpmnElement="S_Submit"><dc:Bounds x="1380" y="65" width="110" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_S_RecvGrades" bpmnElement="S_RecvGrades"><dc:Bounds x="1520" y="65" width="110" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_S_Grades" bpmnElement="S_Grades"><dc:Bounds x="1660" y="65" width="110" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_S_End" bpmnElement="S_End"><dc:Bounds x="1800" y="82" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_F_Start" bpmnElement="F_Start"><dc:Bounds x="60" y="272" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_F_Login" bpmnElement="F_Login"><dc:Bounds x="145" y="255" width="110" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_F_Valid" bpmnElement="F_Valid" isMarkerVisible="true"><dc:Bounds x="300" y="265" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_F_Shell" bpmnElement="F_Shell"><dc:Bounds x="395" y="255" width="110" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_F_Fork" bpmnElement="F_Fork" isMarkerVisible="true"><dc:Bounds x="560" y="265" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_F_Reject" bpmnElement="F_Reject"><dc:Bounds x="655" y="255" width="110" height="70" /></bpmndi:BPMNShape>
