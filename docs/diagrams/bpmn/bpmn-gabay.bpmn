<?xml version="1.0" encoding="UTF-8"?>
<!-- Gabay LMS - BPMN 2.0 collaboration: one pool per role.
     Source flows: docs/diagrams/activity-{student,faculty,admin,staff}.puml
     The Faculty / Admin pool forks after the course shell: enrollment
     handling and content/assessment run as independent branches.
     The shared Staff / All Roles pool holds the support views (calendar,
     inbox, RAG, history) once for every role. The solo Admin
     swimlane keeps account management only. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    id="Gabay_Defs" targetNamespace="http://gabay/lms">
  <collaboration id="Gabay_Collab" name="Gabay LMS">
    <participant id="Part_Student" name="Student" processRef="Proc_Student" />
    <participant id="Part_Faculty" name="Faculty / Admin" processRef="Proc_Faculty" />
    <participant id="Part_Admin" name="Admin" processRef="Proc_Admin" />
    <participant id="Part_Staff" name="Staff / All Roles" processRef="Proc_Staff" />
    <messageFlow id="MF_Request" name="Enrollment request" sourceRef="S_SendReq" targetRef="F_RevReq" />
    <messageFlow id="MF_Decision" name="Approval decision" sourceRef="F_NotifyDec" targetRef="S_RecvDec" />
    <messageFlow id="MF_Grades" name="Released grades" sourceRef="F_ReleaseGr" targetRef="S_RecvGrades" />
  </collaboration>

  <process id="Proc_Student" name="Student" isExecutable="false">
    <startEvent id="S_Start" name="Start"><outgoing>SF1</outgoing></startEvent>
    <task id="S_Login" name="Log in"><incoming>SF1</incoming><incoming>SF3</incoming><outgoing>SF2</outgoing></task>
    <exclusiveGateway id="S_Valid" name="Valid account?"><incoming>SF2</incoming><outgoing>SF3</outgoing><outgoing>SF4</outgoing></exclusiveGateway>
    <task id="S_Join" name="Join course via code"><incoming>SF4</incoming><outgoing>SF5</outgoing></task>
    <sendTask id="S_SendReq" name="Send enrollment request"><incoming>SF5</incoming><outgoing>SF6</outgoing></sendTask>
    <receiveTask id="S_RecvDec" name="Receive decision"><incoming>SF6</incoming><outgoing>SF7</outgoing></receiveTask>
    <exclusiveGateway id="S_Appr" name="Approved?"><incoming>SF7</incoming><outgoing>SF8</outgoing><outgoing>SF9</outgoing></exclusiveGateway>
    <endEvent id="S_EndRej" name="Not enrolled"><incoming>SF8</incoming></endEvent>
    <task id="S_View" name="View modules and items"><incoming>SF9</incoming><outgoing>SF10</outgoing></task>
    <task id="S_Take" name="Take activity / quiz / exam"><incoming>SF10</incoming><outgoing>SF11</outgoing></task>
    <task id="S_Submit" name="Submit answers / files"><incoming>SF11</incoming><outgoing>SF12</outgoing></task>
    <receiveTask id="S_RecvGrades" name="Receive released grades"><incoming>SF12</incoming><outgoing>SF13</outgoing></receiveTask>
    <task id="S_Grades" name="View grades and SPR"><incoming>SF13</incoming><outgoing>SF14</outgoing></task>
    <endEvent id="S_End" name="End"><incoming>SF14</incoming></endEvent>
    <sequenceFlow id="SF1" sourceRef="S_Start" targetRef="S_Login" />
    <sequenceFlow id="SF2" sourceRef="S_Login" targetRef="S_Valid" />
    <sequenceFlow id="SF3" name="no" sourceRef="S_Valid" targetRef="S_Login" />
    <sequenceFlow id="SF4" sourceRef="S_Valid" targetRef="S_Join" />
    <sequenceFlow id="SF5" sourceRef="S_Join" targetRef="S_SendReq" />
    <sequenceFlow id="SF6" sourceRef="S_SendReq" targetRef="S_RecvDec" />
    <sequenceFlow id="SF7" sourceRef="S_RecvDec" targetRef="S_Appr" />
    <sequenceFlow id="SF8" name="no" sourceRef="S_Appr" targetRef="S_EndRej" />
    <sequenceFlow id="SF9" name="yes" sourceRef="S_Appr" targetRef="S_View" />
    <sequenceFlow id="SF10" sourceRef="S_View" targetRef="S_Take" />
    <sequenceFlow id="SF11" sourceRef="S_Take" targetRef="S_Submit" />
    <sequenceFlow id="SF12" sourceRef="S_Submit" targetRef="S_RecvGrades" />
    <sequenceFlow id="SF13" sourceRef="S_RecvGrades" targetRef="S_Grades" />
    <sequenceFlow id="SF14" sourceRef="S_Grades" targetRef="S_End" />
  </process>

  <process id="Proc_Faculty" name="Faculty / Admin" isExecutable="false">
    <startEvent id="F_Start" name="Start"><outgoing>FF1</outgoing></startEvent>
    <task id="F_Login" name="Log in"><incoming>FF1</incoming><incoming>FF3</incoming><outgoing>FF2</outgoing></task>
    <exclusiveGateway id="F_Valid" name="Valid account?"><incoming>FF2</incoming><outgoing>FF3</outgoing><outgoing>FF4</outgoing></exclusiveGateway>
    <task id="F_Shell" name="Create course shell + join code"><incoming>FF4</incoming><outgoing>FF5</outgoing></task>
    <parallelGateway id="F_Fork"><incoming>FF5</incoming><outgoing>FF6</outgoing><outgoing>FF7</outgoing></parallelGateway>
    <task id="F_Publish" name="Publish modules and syllabus"><incoming>FF6</incoming><outgoing>FF14</outgoing></task>
    <task id="F_Assess" name="Create activity / quiz / exam"><incoming>FF14</incoming><outgoing>FF15</outgoing></task>
    <task id="F_Grade" name="Grade submissions"><incoming>FF15</incoming><outgoing>FF16</outgoing></task>
    <sendTask id="F_ReleaseGr" name="Release grades and SPR"><incoming>FF16</incoming><outgoing>FF17</outgoing></sendTask>
    <endEvent id="F_EndB" name="End"><incoming>FF17</incoming></endEvent>
    <receiveTask id="F_RevReq" name="Receive enrollment request"><incoming>FF7</incoming><outgoing>FF8</outgoing></receiveTask>
    <exclusiveGateway id="F_Decide" name="Approve?"><incoming>FF8</incoming><outgoing>FF9</outgoing><outgoing>FF10</outgoing></exclusiveGateway>
    <task id="F_Enroll" name="Enroll student"><incoming>FF9</incoming><outgoing>FF12</outgoing></task>
    <sendTask id="F_NotifyDec" name="Notify decision"><incoming>FF12</incoming><outgoing>FF13</outgoing></sendTask>
    <endEvent id="F_EndA" name="End"><incoming>FF13</incoming></endEvent>
    <sendTask id="F_Reject" name="Notify rejection"><incoming>FF10</incoming><outgoing>FF11</outgoing></sendTask>
    <endEvent id="F_EndRej" name="End"><incoming>FF11</incoming></endEvent>
    <sequenceFlow id="FF1" sourceRef="F_Start" targetRef="F_Login" />
    <sequenceFlow id="FF2" sourceRef="F_Login" targetRef="F_Valid" />
    <sequenceFlow id="FF3" name="no" sourceRef="F_Valid" targetRef="F_Login" />
    <sequenceFlow id="FF4" sourceRef="F_Valid" targetRef="F_Shell" />
    <sequenceFlow id="FF5" sourceRef="F_Shell" targetRef="F_Fork" />
    <sequenceFlow id="FF6" sourceRef="F_Fork" targetRef="F_Publish" />
    <sequenceFlow id="FF7" sourceRef="F_Fork" targetRef="F_RevReq" />
    <sequenceFlow id="FF8" sourceRef="F_RevReq" targetRef="F_Decide" />
    <sequenceFlow id="FF9" name="yes" sourceRef="F_Decide" targetRef="F_Enroll" />
    <sequenceFlow id="FF10" name="no" sourceRef="F_Decide" targetRef="F_Reject" />
    <sequenceFlow id="FF11" sourceRef="F_Reject" targetRef="F_EndRej" />
    <sequenceFlow id="FF12" sourceRef="F_Enroll" targetRef="F_NotifyDec" />
    <sequenceFlow id="FF13" sourceRef="F_NotifyDec" targetRef="F_EndA" />
    <sequenceFlow id="FF14" sourceRef="F_Publish" targetRef="F_Assess" />
    <sequenceFlow id="FF15" sourceRef="F_Assess" targetRef="F_Grade" />
    <sequenceFlow id="FF16" sourceRef="F_Grade" targetRef="F_ReleaseGr" />
    <sequenceFlow id="FF17" sourceRef="F_ReleaseGr" targetRef="F_EndB" />
  </process>

  <process id="Proc_Admin" name="Admin" isExecutable="false">
    <startEvent id="A_Start" name="Start"><outgoing>AF1</outgoing></startEvent>
    <task id="A_Login" name="Log in"><incoming>AF1</incoming><incoming>AF3</incoming><outgoing>AF2</outgoing></task>
    <exclusiveGateway id="A_Valid" name="Valid account?"><incoming>AF2</incoming><outgoing>AF3</outgoing><outgoing>AF4</outgoing></exclusiveGateway>
    <task id="A_Manage" name="Create / edit / deactivate account"><incoming>AF4</incoming><outgoing>AF5</outgoing></task>
    <task id="A_Persist" name="Validate and persist"><incoming>AF5</incoming><outgoing>AF6</outgoing></task>
    <endEvent id="A_End" name="End"><incoming>AF6</incoming></endEvent>
    <sequenceFlow id="AF1" sourceRef="A_Start" targetRef="A_Login" />
    <sequenceFlow id="AF2" sourceRef="A_Login" targetRef="A_Valid" />
    <sequenceFlow id="AF3" name="no" sourceRef="A_Valid" targetRef="A_Login" />
    <sequenceFlow id="AF4" sourceRef="A_Valid" targetRef="A_Manage" />
    <sequenceFlow id="AF5" sourceRef="A_Manage" targetRef="A_Persist" />
    <sequenceFlow id="AF6" sourceRef="A_Persist" targetRef="A_End" />
  </process>

  <process id="Proc_Staff" name="Staff / All Roles" isExecutable="false">
    <startEvent id="T_Start" name="Start"><outgoing>TF1</outgoing></startEvent>
    <task id="T_Login" name="Log in"><incoming>TF1</incoming><incoming>TF3</incoming><outgoing>TF2</outgoing></task>
    <exclusiveGateway id="T_Valid" name="Valid account?"><incoming>TF2</incoming><outgoing>TF3</outgoing><outgoing>TF4</outgoing></exclusiveGateway>
    <parallelGateway id="T_Fork"><incoming>TF4</incoming><outgoing>TF5a</outgoing><outgoing>TF5b</outgoing><outgoing>TF5c</outgoing><outgoing>TF5d</outgoing></parallelGateway>
    <task id="T_Cal" name="View calendar"><incoming>TF5a</incoming><outgoing>TF6a</outgoing></task>
    <task id="T_Inbox" name="View inbox"><incoming>TF5b</incoming><outgoing>TF6b</outgoing></task>
    <task id="T_RAG" name="Query Gabay RAG"><incoming>TF5c</incoming><outgoing>TF6c</outgoing></task>
    <task id="T_Hist" name="View history"><incoming>TF5d</incoming><outgoing>TF6d</outgoing></task>
    <parallelGateway id="T_Join"><incoming>TF6a</incoming><incoming>TF6b</incoming><incoming>TF6c</incoming><incoming>TF6d</incoming><outgoing>TF7</outgoing></parallelGateway>
    <endEvent id="T_End" name="End"><incoming>TF7</incoming></endEvent>
    <sequenceFlow id="TF1" sourceRef="T_Start" targetRef="T_Login" />
    <sequenceFlow id="TF2" sourceRef="T_Login" targetRef="T_Valid" />
    <sequenceFlow id="TF3" name="no" sourceRef="T_Valid" targetRef="T_Login" />
    <sequenceFlow id="TF4" sourceRef="T_Valid" targetRef="T_Fork" />
    <sequenceFlow id="TF5a" sourceRef="T_Fork" targetRef="T_Cal" />
    <sequenceFlow id="TF5b" sourceRef="T_Fork" targetRef="T_Inbox" />
    <sequenceFlow id="TF5c" sourceRef="T_Fork" targetRef="T_RAG" />
    <sequenceFlow id="TF5d" sourceRef="T_Fork" targetRef="T_Hist" />
    <sequenceFlow id="TF6a" sourceRef="T_Cal" targetRef="T_Join" />
    <sequenceFlow id="TF6b" sourceRef="T_Inbox" targetRef="T_Join" />
    <sequenceFlow id="TF6c" sourceRef="T_RAG" targetRef="T_Join" />
    <sequenceFlow id="TF6d" sourceRef="T_Hist" targetRef="T_Join" />
    <sequenceFlow id="TF7" sourceRef="T_Join" targetRef="T_End" />
  </process>

  <bpmndi:BPMNDiagram id="Gabay_Diagram">
    <bpmndi:BPMNPlane id="Gabay_Plane" bpmnElement="Gabay_Collab">
      <bpmndi:BPMNShape id="Sh_Part_S" bpmnElement="Part_Student" isHorizontal="true"><dc:Bounds x="20" y="20" width="2040" height="200" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_Part_F" bpmnElement="Part_Faculty" isHorizontal="true"><dc:Bounds x="20" y="234" width="2040" height="260" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_Part_A" bpmnElement="Part_Admin" isHorizontal="true"><dc:Bounds x="20" y="508" width="2040" height="200" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_Part_T" bpmnElement="Part_Staff" isHorizontal="true"><dc:Bounds x="20" y="722" width="2040" height="320" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_S_Start" bpmnElement="S_Start"><dc:Bounds x="60" y="82" width="36" height="36" /></bpmndi:BPMNShape>
