@startuml
title Gabay LMS - Faculty Use Case
left to right direction
skinparam usecase {
  BackgroundColor #8AC9F5
  BorderColor black
}
skinparam actor {
  BackgroundColor #8AC9F5
  BorderColor black
}
skinparam rectangle {
  BackgroundColor white
  BorderColor black
}
skinparam usecase<<spacer>> {
  BackgroundColor none
  BorderColor white
  FontColor white
}
skinparam arrowColor black
skinparam linetype polyline
skinparam nodesep 6
skinparam ranksep 12

actor "Faculty" as Faculty

rectangle "Gabay LMS" {
  together {
    usecase "Manage Courses and Sections\n(Create shell + capacity)" as UC2
    usecase "Approve Enrollment Requests\n(People queue + Bell)" as UC3
  }
  together {
    usecase "Manage Courses\n(Publish Modules)" as UC4
    usecase "Manage Module Items" as UC4a
    usecase "Add / Reply on Module" as UC4b
  }
  together {
    usecase "Upload Syllabus Files" as UC5a
    usecase "Publish Syllabus" as UC5b
  }
  together {
    usecase "Manage Activities" as UC6a
    usecase "Manage Quizzes" as UC6b
    usecase "Manage Exams" as UC6c
    usecase "Release Grades and SPR" as UC6d
    usecase " " as SP6d <<spacer>>
  }
  together {
    usecase "Post Institutional\nAnnouncements" as UC7
    usecase "Add / Reply Comments" as UC7b
  }
  together {
    usecase "Access Calendar" as UC8
    usecase "Add Schedule Event" as UC8a
    usecase "Remove Schedule Event" as UC8b
  }
  together {
    usecase "Access Inbox" as UC9
    usecase "Direct message users" as UC9a
    usecase "Create group" as UC9b
    usecase "Message group" as UC9c
  }
  together {
    usecase "Access Gabay RAG" as UCRAG
    usecase "Generate Graph" as UCRAG_G
    usecase "Generate Tables" as UCRAG_T
    usecase "Generate Report" as UCRAG_R
  }
  together {
    usecase "Access History" as UC10
  }
}

Faculty --> UC2
Faculty --> UC3
Faculty --> UC4
Faculty --> UC5a
Faculty --> UC6a
Faculty --> UC6b
Faculty --> UC6c
Faculty --> UC7
Faculty --> UC8
Faculty --> UC9
Faculty --> UCRAG
Faculty --> UC10

UC4 ..> UC4a : <<extend>>
UC4a ..> UC4b : <<extend>>
UC5a ..> UC5b : <<include>>
UC6a ..> UC6d : <<extend>>
UC6b ..> UC6d : <<extend>>
UC6c ..> UC6d : <<extend>>
UC7 ..> UC7b : <<extend>>
UC8 ..> UC8a : <<extend>>
UC8 ..> UC8b : <<extend>>
UC9 ..> UC9a : <<extend>>
UC9 ..> UC9b : <<extend>>
UC9b ..> UC9c : <<extend>>
UCRAG ..> UCRAG_G : <<extend>>
UCRAG ..> UCRAG_T : <<extend>>
UCRAG ..> UCRAG_R : <<extend>>
UC6d -[hidden]down-> SP6d
@enduml
